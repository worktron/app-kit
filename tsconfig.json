{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "bun",
      "chrome"
    ],
    "allowJs": true,
    "checkJs": true
  },
  "include": [
    "**/*"
  ],
  "exclude": [
    "node_modules",
    "**/dist",
    "test-results",
    "playwright-report"
  ]
}
