    "./extension/host": "./extension/host/index.ts",
    "./extension/harness": "./extension/harness/index.ts",
    "./extension/testing/chrome": "./extension/testing/chrome.ts",
    "./extension/copy": "./extension/copy.ts",
    "./extension/worker/*": "./extension/worker/*",
    "./desktop-sign-in": "./desktop-sign-in/index.ts",
    "./desktop-sign-in/server": "./desktop-sign-in/server.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "bun test",
    "test:e2e": "bash scripts/e2e.sh",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint .",
